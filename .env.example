# Reachy Mini MCP — environment configuration
# Copy to .env and fill in your keys. Never commit .env (it is gitignored).

# Text-to-speech + speech-to-text (Deepgram Aura-2 / Nova-2). Required for speak/listen.
DEEPGRAM_API_KEY=your_deepgram_key_here

# Optional: Grok Voice for expressive TTS (used automatically when XAI_API_KEY is set).
# XAI_API_KEY=your_xai_key_here
# GROK_VOICE=eve   # ara | eve | leo | rex | sal

# Optional: override the robot daemon URL (default http://reachy-mini.local:8000/api).
# REACHY_DAEMON_URL=http://reachy-mini.local:8000/api
